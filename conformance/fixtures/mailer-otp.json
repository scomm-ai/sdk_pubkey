{
  "host": "mailer",
  "seesPlaintextEmail": true,
  "otp": "11-character Base62 (0-9A-Za-z)",
  "brand": "Scomm.AI",
  "endpoints": {
    "POST /v1/mailboxes/{sha256}/challenges": {
      "body": {
        "type": "https://discovery.scomm.ai/challenges/email-otp/v1",
        "email": "<canonical>",
        "purpose": "https://discovery.scomm.ai/operations/msk/enroll/v1"
      },
      "response": {
        "status": 200,
        "body": { "id": "<challenge id>", "status": "pending" }
      }
    },
    "POST /v1/mailboxes/{sha256}/challenges/{id}/responses": {
      "body": {
        "response": { "code": "<11 Base62>" }
      },
      "success": {
        "identity_id": "<64 lowercase hex>",
        "otp_grant": "<grant v1>"
      },
      "grantClaimsExclude": ["email", "mailbox", "address"],
      "grantClaims": {
        "amr": ["otp"]
      },
      "failure": "challenge_failed"
    }
  }
}
